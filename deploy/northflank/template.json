{
  "apiVersion": "v1.2",
  "spec": {
    "kind": "Template",
    "spec": {
      "name": "career-cards",
      "description": "One nightly-job-search worker: a ManualJob (run) and a DeploymentService (serve).",
      "arguments": {
        "PROJECT_ID": {
          "type": "string",
          "description": "Northflank project ID",
          "default": ""
        },
        "IMAGE": {
          "type": "string",
          "description": "Docker image (fork and push your own, or use the upstream public image)",
          "default": "ghcr.io/samartemberlin/career-cards:main"
        },
        "JOBS_BOARD_ID": {
          "type": "string",
          "description": "Trello Jobs board ID (from tools/onboard.ts)",
          "default": ""
        },
        "PROFILES_BOARD_ID": {
          "type": "string",
          "description": "Trello Profiles board ID (from tools/onboard.ts)",
          "default": ""
        },
        "SYSTEM_BOARD_ID": {
          "type": "string",
          "description": "Trello System board ID (from tools/onboard.ts)",
          "default": ""
        },
        "PUBLIC_URL": {
          "type": "string",
          "description": "Public HTTPS origin of the serve service, no path (fill after first deploy; see DEPLOY.md step 6)",
          "default": ""
        },
        "SERVICE_PLAN": {
          "type": "string",
          "description": "Northflank plan for the serve service",
          "default": "nf-compute-20"
        },
        "JOB_PLAN": {
          "type": "string",
          "description": "Northflank plan for the run job",
          "default": "nf-compute-100-2"
        }
      },
      "steps": [
        {
          "kind": "ManualJob",
          "ref": "job",
          "spec": {
            "name": "run",
            "projectId": "${args.PROJECT_ID}",
            "billing": {
              "deploymentPlan": "${args.JOB_PLAN}"
            },
            "runOnSourceChange": "never",
            "backoffLimit": 0,
            "activeDeadlineSeconds": 3600,
            "deployment": {
              "docker": {
                "configType": "customCommand",
                "customCommand": "run"
              }
            },
            "image": {
              "imageType": "external",
              "externalImage": "${args.IMAGE}"
            },
            "runtimeEnvironment": {
              "JOBS_BOARD_ID": "${args.JOBS_BOARD_ID}",
              "PROFILES_BOARD_ID": "${args.PROFILES_BOARD_ID}",
              "SYSTEM_BOARD_ID": "${args.SYSTEM_BOARD_ID}"
            }
          }
        },
        {
          "kind": "DeploymentService",
          "ref": "serve",
          "spec": {
            "name": "serve",
            "projectId": "${args.PROJECT_ID}",
            "billing": {
              "deploymentPlan": "${args.SERVICE_PLAN}"
            },
            "deployment": {
              "instances": 1,
              "docker": {
                "configType": "default"
              }
            },
            "image": {
              "imageType": "external",
              "externalImage": "${args.IMAGE}"
            },
            "ports": [
              {
                "name": "http",
                "internalPort": 8080,
                "public": true,
                "protocol": "HTTP"
              }
            ],
            "healthChecks": [
              {
                "type": "livenessProbe",
                "protocol": "HTTP",
                "path": "/healthz",
                "port": 8080
              }
            ],
            "runtimeEnvironment": {
              "JOBS_BOARD_ID": "${args.JOBS_BOARD_ID}",
              "PROFILES_BOARD_ID": "${args.PROFILES_BOARD_ID}",
              "SYSTEM_BOARD_ID": "${args.SYSTEM_BOARD_ID}",
              "PUBLIC_URL": "${args.PUBLIC_URL}",
              "NORTHFLANK_PROJECT_ID": "${args.PROJECT_ID}",
              "NORTHFLANK_JOB_ID": "${refs.job.id}"
            }
          }
        }
      ]
    }
  }
}
